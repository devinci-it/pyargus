[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Web Framework
uvicorn = {extras = ["standard"], version = ">=0.24.0"}
# Database ORM
peewee = ">=3.17.0"
# SSH Management
paramiko = ">=3.4.0"
# Encryption
pycryptodome = ">=3.19.0"
# Environment Variables
python-dotenv = ">=1.0.0"
# Utilities
python-dateutil = ">=2.8.2"
# Logging
pylogger = {file = "lib/pylogger/pylogger-1.2.0-py3-none-any.whl"}
tabulate = ">=0.9.0"
colorama = ">=0.4.0"
pyargus = {file = ".", editable = true}

[dev-packages]
black = ">=23.12.0"
flake8 = ">=6.1.0"
mypy = ">=1.7.1"
isort = ">=5.13.2"
httpx = ">=0.25.2"
faker = ">=21.0.0"
pytest = ">=7.0.0"
pytest-cov = ">=4.0.0"
build = "*"
wheel = "*"
pyargus = {file = ".", editable = true}

[requires]
python_version = "3.12"
