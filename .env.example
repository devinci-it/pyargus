# Environment Variables Template
# Copy this file to .env and fill in the values

# Application Settings
APP_NAME=PyArgus
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=true
API_WORKERS=4

# Database Configuration
DATABASE_URL=sqlite:///pyargus.db
DATABASE_ECHO=false

# Security Configuration

# ENCRYPTION_KEY (Leave empty in development - auto-generated)
# In PRODUCTION: Set from environment variable or secrets manager
# DO NOT commit real keys to git!
ENCRYPTION_KEY=

# SSH_KEY_PATH (Optional in dev, required in production)
# Development: Auto-defaults to ~/.ssh/id_rsa if not set
# Production: Must be set to actual SSH key path
SSH_KEY_PATH=

AUTHORIZED_KEYS_PATH=~/.ssh/authorized_keys
DEFAULT_PORT_START=9221
DEFAULT_PORT_END=9999
